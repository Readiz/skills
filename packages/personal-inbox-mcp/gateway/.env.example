# Copy values into your secret manager or an ignored local .env file.
PERSONAL_INBOX_PUBLIC_URL=https://inbox.example.net
PERSONAL_INBOX_GITHUB_CLIENT_ID=replace-with-github-oauth-app-client-id
PERSONAL_INBOX_GITHUB_CLIENT_SECRET=replace-with-github-oauth-app-client-secret
PERSONAL_INBOX_OWNER_GITHUB_ID=replace-with-numeric-github-user-id
PERSONAL_INBOX_JWT_SIGNING_KEY=replace-with-a-persistent-random-secret-of-at-least-32-bytes
PERSONAL_INBOX_AUTH_DIR=/var/lib/personal-inbox-gateway/auth
PERSONAL_INBOX_DIR=/var/lib/personal-inbox/data
# Optional; defaults to PERSONAL_INBOX_DIR/imports
# PERSONAL_INBOX_IMPORT_DIR=/var/lib/personal-inbox/imports
# Optional; defaults to the node found on PATH
# PERSONAL_INBOX_NODE=/usr/local/bin/node
